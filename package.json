{
	"name": "expo-build-disk-cache",
	"description": "Cache Expo iOS and Android native builds on local disk to skip repeated compilations.",
	"version": "0.8.0",
	"author": {
		"name": "WookieFPV (Lukas Müller)",
		"url": "https://github.com/WookieFPV"
	},
	"license": "MIT",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"/dist"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/WookieFPV/expo-build-disk-cache"
	},
	"homepage": "https://github.com/WookieFPV/expo-build-disk-cache#readme",
	"bugs": {
		"url": "https://github.com/WookieFPV/expo-build-disk-cache/issues"
	},
	"keywords": [
		"expo",
		"react-native",
		"build-cache",
		"ios",
		"android",
		"prebuild"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsup",
		"build:dev": "tsup --watch --clean false",
		"changeset": "changeset",
		"test": "bun test",
		"test:perf": "PERF_TESTS=1 bun test src/__tests__/resolveBuildCache.perf.test.ts",
		"lint": "bunx biome check --fix",
		"lint:CI": "bunx biome check",
		"release": "changeset publish",
		"typecheck": "tsc",
		"version-packages": "changeset version",
		"prepublishOnly": "bun run typecheck && bun run lint:CI && bun test && bun run build"
	},
	"dependencies": {
		"cosmiconfig": "^10.0.0",
		"env-paths": "^2.2.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@changesets/cli": "3.0.1",
		"@total-typescript/ts-reset": "0.6.1",
		"@tsconfig/bun": "1.0.11",
		"@types/bun": "1.4.1",
		"lefthook": "2.1.12",
		"tsup": "8.5.1",
		"typescript": "7.0.2",
		"@expo/config": "57.0.9"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"overrides": {
		"uuid": "14.0.2",
		"esbuild": "0.28.2",
		"brace-expansion": "5.0.9",
		"browserslist": "4.28.8",
		"@babel/core": "8.0.1",
		"@xmldom/xmldom": "0.9.12",
		"js-yaml@^3.0.0": "3.15.1",
		"js-yaml@^4.0.0": "4.3.1",
		"nanoid": "6.0.1",
		"postcss": "8.5.27"
	}
}
