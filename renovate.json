{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended"],
	"packageRules": [
		{
			"matchUpdateTypes": ["minor", "patch"],
			"matchCurrentVersion": "!/^0/",
			"automerge": true
		},
		{
			"matchDepTypes": ["devDependencies"],
			"matchUpdateTypes": ["minor", "patch"],
			"automerge": true
		},
		{
			"matchPackageNames": ["env-paths"],
			"enabled": false
		},
		{
			"description": "tsup (rollup-plugin-dts) needs the TypeScript compiler API to emit dist/index.d.ts; TS 7 has none, and tsup 9 still calls it directly even with @typescript/typescript6 installed. Revisit when tsup supports TS 7.",
			"matchPackageNames": ["typescript"],
			"allowedVersions": "<7"
		}
	],
	"schedule": ["every weekend"],
	"labels": ["dependencies"],
	"prHourlyLimit": 4,
	"prConcurrentLimit": 16,
	"separateMinorPatch": true,
	"semanticCommits": "enabled",
	"semanticCommitType": "chore",
	"semanticCommitScope": null,
	"minimumReleaseAge": "3 days",
	"vulnerabilityAlerts": {
		"labels": ["security"],
		"automerge": false
	}
}
